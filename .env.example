# Twilio Configuration
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# SMS Service Configuration
# Set to 'true' to use mock SMS service (for development/testing)
USE_MOCK_SMS=false

# Skip Twilio signature validation (for development only)
SKIP_TWILIO_VALIDATION=false

# Database Configuration
DB_PATH=nbcco_ratings.db

# Flask Configuration
FLASK_DEBUG=false
PORT=5000

# Optional: Webhook URL for testing
# WEBHOOK_URL=https://your-domain.com/sms/webhook
